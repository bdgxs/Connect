-- Tab Management
local function createTab(name, parent)
    local tab = createUIElement("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false
    }, parent)

    local tabButton = createUIElement("TextButton", {
        Size = UDim2.new(0, 100, 0, 30),
        Position = UDim2.new(0, 10 + (#parent:GetChildren() - 1) * 110, 0, 0),
        Text = name,
        BackgroundTransparency = 0.5,
        BackgroundColor3 = Color3.new(0.1, 0.1, 0.2),
        TextColor3 = Color3.new(0.8, 0.8, 1),
        Font = Enum.Font.Gotham,
        TextSize = 14
    }, parent)

    createUIElement("UICorner", {CornerRadius = UDim.new(0.2, 0)}, tabButton)

    createUIElement("UIGradient", {
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(100, 100, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 50, 200))
        }
    }, tabButton)

    tabButton.MouseButton1Click:Connect(function()
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("Frame") then
                child.Visible = child == tab
            end
        end
    end)

    return tab
end

local scriptsTab = createTab("Scripts", mainFrame)
local settingsTab = createTab("Settings", mainFrame)

-- Initial Setup for Script Management
local scriptStore = DataStoreService:GetDataStore("UserScripts")
local scriptList = {}

-- Simplified Script Box for Adding Scripts
local scriptBox = createUIElement("TextBox", {
    Size = UDim2.new(1, -20, 0.7, 0),
    Position = UDim2.new(0, 10, 0, 40),
    MultiLine = true,
    BackgroundColor3 = Color3.new(0.1, 0.1, 0.15),
    TextColor3 = Color3.new(1, 1, 1),
    Font = Enum.Font.Gotham,
    TextSize = 14
}, scriptsTab)

-- Handles Script Saving
scriptBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        table.insert(scriptList, {script = scriptBox.Text, autoRun = false})
        saveScriptsToDataStore()
    end
end)

-- Settings Tab Content
local destroyButton = createUIElement("TextButton", {
    Size = UDim2.new(0, 100, 0, 30),
    Position = UDim2.new(0, 10, 0, 10),
    Text = "Destroy GUI",
    BackgroundColor3 = Color3.new(0.7, 0, 0),
    TextColor3 = Color3.new(1, 1, 1),
    Font = Enum.Font.GothamBlack,
    TextSize = 16
}, settingsTab)

destroyButton.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

-- Save Scripts to DataStore
local function saveScriptsToDataStore()
    local success, jsonData = safePcall(HttpService.JSONEncode, HttpService, scriptList)
    if success then
        safePcall(scriptStore.SetAsync, scriptStore, player.UserId .. "_script", jsonData)
    end
end

-- Load Scripts from DataStore on Initialization
do
    local success, data = safePcall(scriptStore.GetAsync, scriptStore, player.UserId .. "_script")
    if success and data then
        local decoded, scriptData = safePcall(HttpService.JSONDecode, HttpService, data)
        if decoded then
            scriptList = scriptData
        end
    end
end

-- Initial Visibility
scriptsTab.Visible = true
mainFrame.Visible = false  -- Set Main Frame to initially