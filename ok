-- Tab Creation
local function createTab(name)
    local tab = createUIElement("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false
    }, mainFrame)

    local tabButton = createUIElement("TextButton", {
        Size = UDim2.new(0, 100, 0, 30),
        Position = UDim2.new(0, 10 + (#mainFrame:GetChildren() - 1) * 110, 0, 0),
        Text = name,
        BackgroundTransparency = 0.5,
        BackgroundColor3 = Color3.new(0.1, 0.1, 0.2),
        TextColor3 = Color3.new(0.8, 0.8, 1),
        Font = Enum.Font.Gotham,
        TextSize = 14
    }, mainFrame)

    createUIElement("UICorner", { CornerRadius = UDim.new(0.2, 0) }, tabButton)

    createUIElement("UIGradient", {
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(100, 100, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 50, 200))
        }
    }, tabButton)

    tabButton.MouseButton1Click:Connect(function()
        for _, child in ipairs(mainFrame:GetChildren()) do
            if child:IsA("Frame") then
                child.Visible = child == tab
            end
        end
    end)

    return tab
end

local scriptsTab = createTab("Scripts")
local settingsTab = createTab("Settings")

-- Scripts Data Management
local scriptStore = DataStoreService:GetDataStore("UserScripts")
local scriptList = {}

local function updateScriptList()
    scriptsTab:ClearAllChildren()

    for index, scriptData in ipairs(scriptList) do
        local scriptButton = createUIElement("TextButton", {
            Size = UDim2.new(1, -40, 0, 30),
            Position = UDim2.new(0, 0, 0, (index-1) * 30),
            Text = "Execute " .. index,
            BackgroundColor3 = Color3.new(0, 0.3, 0.6),
            TextColor3 = Color3.new(1, 1, 1),
            Font = Enum.Font.GothamBlack,
            TextSize = 14
        }, scriptsTab)

        scriptButton.MouseButton1Click:Connect(function()
            local success, func = safePcall(loadstring, scriptData.script)
            if success then
                safePcall(func)
            end
        end)

        local toggle = createUIElement("TextButton", {
            Size = UDim2.new(0, 30, 0, 30),
            Position = UDim2.new(1, -35, 0, (index-1) * 30),
            Text = scriptData.autoRun and "ON" or "OFF",
            BackgroundColor3 = scriptData.autoRun and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
        }, scriptsTab)

        toggle.MouseButton1Click:Connect(function()
            scriptData.autoRun = not scriptData.autoRun
            toggle.Text = scriptData.autoRun and "ON" or "OFF"
            toggle.BackgroundColor3 = scriptData.autoRun and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
            saveScriptsToDataStore()
        end)
    end
end

local function loadScriptsFromDataStore()
    local success, data = safePcall(scriptStore.GetAsync, scriptStore, player.UserId .. "_script")
    if success and data then
        local success2, scriptData = safePcall(HttpService.JSONDecode, HttpService, data)
        if success2 then
            scriptList = scriptData
            for _, script in ipairs(scriptList) do
                if script.autoRun then
                    local success3, func = safePcall(loadstring, script.script)
                    if success3 then
                        safePcall(func)
                    end
                end
            end
            updateScriptList()
        end
    end
end

local function saveScriptsToDataStore()
    local success, jsonData = safePcall(HttpService.JSONEncode, HttpService, scriptList)
    if success then
        safePcall(scriptStore.SetAsync, scriptStore, player.UserId .. "_script", jsonData)
    end
end

-- Initialize saved scripts
loadScriptsFromDataStore()

